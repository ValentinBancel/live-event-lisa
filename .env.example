# Django Settings
# IMPORTANT: Generate a new SECRET_KEY for production!
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (e.g., yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com

# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/live_event_db

# Alternative: Individual database settings (used if DATABASE_URL is not set)
# POSTGRES_DB=live_event_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password
# DB_HOST=db
# DB_PORT=5432

# CORS Settings
# Allow all origins (set to False in production and use CORS_ALLOWED_ORIGINS instead)
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated list of allowed origins (only used if CORS_ALLOW_ALL_ORIGINS=False)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Settings (for production)
# Set to False if not using HTTPS (not recommended for production)
SECURE_SSL_REDIRECT=True

# Optional: Port for the application (default: 8000)
PORT=8000
